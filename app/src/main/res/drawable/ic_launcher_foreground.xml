            android:pathData="M22,16 m -2,0 a 2,2 0 1,0 4,0 a 2,2 0 1,0 -4,0" />

        <!-- 十字键（D-Pad） -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#000000"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:pathData="M25,46 V54" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#000000"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:pathData="M21,50 H29" />

        <!-- A/B 按钮 -->
