            android:fillColor="#00000000"
            android:strokeColor="#000000"
            android:strokeWidth="4"
            android:pathData="M47,49 m -4,0 a 4,4 0 1,0 8,0 a 4,4 0 1,0 -8,0" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#000000"
            android:strokeWidth="4"
            android:pathData="M53,43 m -4,0 a 4,4 0 1,0 8,0 a 4,4 0 1,0 -8,0" />

        <!-- Select / Start 斜杠按钮 -->
        <group android:rotation="-20" android:pivotX="32" android:pivotY="62">
            <path
                android:fillColor="#00000000"
                android:strokeColor="#000000"
                android:strokeWidth="3"
                android:strokeLineCap="round"
