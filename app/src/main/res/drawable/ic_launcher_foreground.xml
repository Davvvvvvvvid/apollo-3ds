                android:fillColor="#00000000"
                android:strokeColor="#000000"
                android:strokeWidth="3"
                android:strokeLineCap="round"
                android:pathData="M36,60 H42" />
        </group>

        <!-- 右下扬声器斜线栅格 -->
        <group android:rotation="-35" android:pivotX="56" android:pivotY="64">
            <path
                android:fillColor="#00000000"
                android:strokeColor="#000000"
                android:strokeWidth="3"
                android:strokeLineCap="round"
                android:pathData="M52,60 H58" />
            <path
                android:fillColor="#00000000"
                android:strokeColor="#000000"
                android:strokeWidth="3"
                android:strokeLineCap="round"
                android:pathData="M52,64 H58" />
            <path
                android:fillColor="#00000000"
                android:strokeColor="#000000"
                android:strokeWidth="3"
                android:strokeLineCap="round"
                android:pathData="M52,68 H58" />
        </group>

        <!-- 底部小孔（装饰） -->
        <path android:fillColor="#00000000" android:strokeColor="#000000" android:strokeWidth="3" android:pathData="M30,70 m -1.5,0 a 1.5,1.5 0 1,0 3,0 a 1.5,1.5 0 1,0 -3,0" />
